[Unit]
Description=İlmek registry
Documentation=file:///usr/share/doc/ilmek/OPERATIONS.md
# On the node that owns the user network, the listen address exists only after the network unit.
After=network.target ilmek-network.service
Wants=ilmek-network.service

[Service]
User=ilmek
Group=ilmek
ExecStart=/usr/local/bin/ilmek registry serve --config /etc/ilmek/registry.toml
Restart=on-failure
RestartSec=3
# The registry binds ports above 1024 only and needs no privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
ReadWritePaths=/var/lib/ilmek/registry

[Install]
WantedBy=multi-user.target
