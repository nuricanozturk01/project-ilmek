[Unit]
Description=İlmek application host (joins the node by itself)
Documentation=file:///usr/share/doc/ilmek/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
User=ilmek
Group=ilmek
Environment=ILMEK_HOME=/var/lib/ilmek
ExecStart=/usr/local/bin/ilmek host start
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ilmek

[Install]
WantedBy=multi-user.target
