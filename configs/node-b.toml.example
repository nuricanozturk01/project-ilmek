# NODE-B: user network 10.77.20.0/24; joins NODE-A's transit network as a Wi-Fi station.
name = "NODE-B"
country = "TR"
snapshot_dir = "/var/lib/ilmek/network"

[user_network]
interface = "wlan0"
address = "10.77.20.1/24"
ssid = "ILMEK-B"
channel = 1
band = "2.4"
passphrase_file = "/etc/ilmek/secrets/user.pass"

[user_network.dhcp]
range_start = "10.77.20.100"
range_end = "10.77.20.199"
lease = "12h"

[[user_network.dhcp.reservations]]
name = "host-2"
mac = "aa:bb:cc:dd:ee:02"   # replace with HOST-2's real MAC address
address = "10.77.20.10"

[transit]
interface = "wlan1"
address = "10.77.254.2/30"
mode = "station"             # follows NODE-A's access point and channel
ssid = "ILMEK-TRANSIT"
passphrase_file = "/etc/ilmek/secrets/transit.pass"

[[routes]]
destination = "10.77.10.0/24"
via = "10.77.254.1"

[firewall]
ports = [47401, 47402]
