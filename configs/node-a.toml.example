# NODE-A: user network 10.77.10.0/24, hosts the registry (REQUIREMENTS §9). Copy to node-a.toml and
# adjust interface names, channels and country. Nothing here is applied until `ilmek network
# apply --yes`. Review with: ilmek network plan --config node-a.toml
name = "NODE-A"
# Regulatory domain; radios must not transmit without one.
country = "TR"
snapshot_dir = "/var/lib/ilmek/network"

[user_network]
interface = "wlan0"
address = "10.77.10.1/24"
ssid = "ILMEK-A"
channel = 6
band = "2.4"
# First line: 8–63 printable ASCII characters. Root-only file, never in this config.
passphrase_file = "/etc/ilmek/secrets/user.pass"

[user_network.dhcp]
range_start = "10.77.10.100"
range_end = "10.77.10.199"
lease = "12h"

[[user_network.dhcp.reservations]]
name = "host-1"
mac = "aa:bb:cc:dd:ee:01"   # replace with HOST-1's real MAC address
address = "10.77.10.10"

[transit]
interface = "wlan1"
address = "10.77.254.1/30"
mode = "access_point"
ssid = "ILMEK-TRANSIT"
channel = 11
band = "2.4"
passphrase_file = "/etc/ilmek/secrets/transit.pass"

[[routes]]
destination = "10.77.20.0/24"
via = "10.77.254.2"

[firewall]
ports = [47401, 47402]
