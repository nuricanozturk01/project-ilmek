# Registry. `ilmek node` writes a file like this for you (<home>/registry.toml); use this one with
# `ilmek registry serve --config` (a registry without an application host).
data_dir = "/var/lib/ilmek/registry"
listen = "0.0.0.0:47401"
# Networks hosts may advertise endpoints in. Leave empty (or remove) to allow every address.
allowed_endpoints = []
max_connections = 128
