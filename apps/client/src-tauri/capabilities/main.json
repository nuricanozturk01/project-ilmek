{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The trusted shell UI (the `main` window's only webview). Application pages run in sandboxed frames and get no permissions.",
  "permissions": [
    "core:event:default",
    "allow-shell-state",
    "allow-shell-join",
    "allow-shell-refresh",
    "allow-shell-catalog",
    "allow-shell-open",
    "allow-shell-cancel",
    "allow-shell-cached",
    "allow-shell-remove",
    "allow-shell-history",
    "allow-shell-bookmark",
    "allow-shell-diagnostics",
    "allow-shell-show-tab",
    "allow-shell-close-tab",
    "allow-shell-pending",
    "allow-shell-bridge"
  ],
  "windows": [
    "main"
  ]
}
