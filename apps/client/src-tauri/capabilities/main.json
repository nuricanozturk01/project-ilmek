{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The trusted shell UI. Application pages never get these permissions.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-shell-state",
    "allow-shell-join",
    "allow-shell-refresh",
    "allow-shell-catalog",
    "allow-shell-open",
    "allow-shell-cancel",
    "allow-shell-cached",
    "allow-shell-remove",
    "allow-shell-history",
    "allow-shell-bookmark",
    "allow-shell-diagnostics",
    "allow-shell-close-app"
  ]
}
